# macOS Finder metadata
.DS_Store

# Claude Code local tooling settings (machine-specific, not part of the site)
.claude/

# NOTE: finance/config.js IS committed on purpose. It holds only the Supabase
# Project URL + the ANON public key, both of which are designed to ship in
# client code — Row Level Security (not key secrecy) protects the data. This
# makes Bloom work on every device with no per-device setup. The genuinely
# secret values (DB password, service_role key, Claude API key) are NOT here.

# Supabase CLI local link state (machine-specific, generated by `supabase link`)
supabase/.temp/

# Private: reserved daily-puzzle answers + authoring tooling.
# Kept out of this public repo; lives in a private dev repo instead.
games/nonogram/puzzles/special/
scripts/author-pictures.js
scripts/review-banked-pictures.js
scripts/apply-bank-review.js
scripts/merge-pictures.js
scripts/kept-pictures.json
scripts/discarded-pictures.json

# VAPID private key for push notifications. The PUBLIC half is committed in
# finance/config.js on purpose (it ships to browsers by design); the private
# half must only ever live as a Supabase secret.
vapid.json
finance/vapid.json
